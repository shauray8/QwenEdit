+def _layernorm_modulate_inputs(B, S, K, amplitude, packed_gate):
+    gen = torch.Generator(device="cuda").manual_seed(3)
+    x = torch.randn(B, S, K, device="cuda", generator=gen) * amplitude
+    x = (x + amplitude * torch.randn(K, device="cuda", generator=gen)).bfloat16()
+    update = torch.randn(B, S, K, device="cuda", generator=gen).bfloat16()
+    # scale and gate as the DiT chunks them from one adaLN projection; tanh()
+    # copies the gate out of it, tanh_() keeps it a strided view.
+    modulation = torch.randn(B, 4 * K, device="cuda", generator=gen).bfloat16()
+    scale, gate = modulation.chunk(4, dim=-1)[:2]
+    gate = gate.tanh() if packed_gate else gate.tanh_()
+    return x, update, scale, gate
+
+
+# K = 3328 leaves the LayerNorm threads a partial last pass (832 vectors over 128
+# threads); a K that does so is never a multiple of 512.
+@pytest.mark.parametrize(
