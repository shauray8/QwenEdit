+def test_layernorm_modulate_rotate_bitwise_equals_eager(B, S, K, group_size, amplitude, residual):
+    x, update, scale, gate = _layernorm_modulate_inputs(
+        B, S, K, amplitude, packed_gate=residual
+    )
+    eps = 1e-6
+    h = x + update * gate[:, None] if residual else x
+    y = F.layer_norm(h, (K,), eps=eps) * (1 + scale[:, None])
+    ref_q, ref_scale = convrot_rotate_quantize_activation(y.reshape(-1, K), group_size)
+    x_q, x_scale, hidden = convrot_layernorm_modulate_rotate_quantize(
+        x,
+        scale,
+        eps,
+        group_size,
+        update=update if residual else None,
+        gate=gate if residual else None,
+    )
+    assert torch.equal(x_q, ref_q)
+    assert torch.equal(x_scale, ref_scale)
+    if residual:
+        assert torch.equal(hidden.view(torch.int16), h.view(torch.int16))
+    else:
+        assert hidden is None
+
