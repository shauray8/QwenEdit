+// ----------------------- LayerNorm + modulate + rotate -----------------------
+// y = bf16(LN(x) * bf16(1 + scale)) rotated and quantized without storing y, x
+// optionally formed as bf16(residual + bf16(update * gate)) on the way in. The
+// statistics replicate at::native::vectorized_layer_norm_kernel<BFloat16, float>
+// (see the numerics contract in kda_kernels/layernorm_modulate_triton.py): 128
+// threads per row, thread t Welford-pushes the 4-element vectors t, t + 128, ...,
+// shfl.down folds 16..1, then warps (0,2), (1,3), (0,1). The row is staged in
+// shared memory between that layout and the rotate layout. Explicit PTX keeps
+// --use_fast_math from flushing denormals or contracting the chain.
+constexpr int kLnThreads = 128;
+constexpr int kLnWarps = kLnThreads / 32;
+constexpr int kLnMaxK = kLnWarps * kRotTileElems;
+constexpr int kLnRowsPerBlock = 2;
+
+SGL_DEVICE float ln_add(float a, float b) {
+  float r;
+  asm("add.rn.f32 %0, %1, %2;" : "=f"(r) : "f"(a), "f"(b));
+  return r;
+}
+SGL_DEVICE float ln_sub(float a, float b) {
+  float r;
+  asm("sub.rn.f32 %0, %1, %2;" : "=f"(r) : "f"(a), "f"(b));
+  return r;
+}
+SGL_DEVICE float ln_mul(float a, float b) {
+  float r;
+  asm("mul.rn.f32 %0, %1, %2;" : "=f"(r) : "f"(a), "f"(b));
+  return r;
+}
+SGL_DEVICE float ln_fma(float a, float b, float c) {
+  float r;
+  asm("fma.rn.f32 %0, %1, %2, %3;" : "=f"(r) : "f"(a), "f"(b), "f"(c));
+  return r;
+}
+SGL_DEVICE float ln_div(float a, float b) {
+  float r;
+  asm("div.rn.f32 %0, %1, %2;" : "=f"(r) : "f"(a), "f"(b));
+  return r;
+}
+// nvcc's guarded-reciprocal fast path, which aten's 1 / count compiles to.
+SGL_DEVICE float ln_rcp(float x) {
+  float r;
+  asm("{\n\t.reg .f32 r0, e, e2;\n\t"
+      "rcp.approx.f32 r0, %1;\n\t"
+      "fma.rn.f32 e, %1, r0, 0fBF800000;\n\t"
+      "sub.ftz.f32 e2, 0f80000000, e;\n\t"
+      "fma.rn.f32 %0, r0, e2, r0;\n\t}"
+      : "=f"(r)
+      : "f"(x));
+  return r;
+}
+// rsqrtf as a non-ftz build emits it: MUFU.RSQ with a 2^24 / 2^12 rescale for subnormals.
+SGL_DEVICE float ln_rsqrt(float x) {
+  const bool subnormal = fabsf(x) < 1.17549435e-38f;
+  const float in = subnormal ? ln_mul(x, 16777216.f) : x;
+  float r;
+  asm("rsqrt.approx.f32 %0, %1;" : "=f"(r) : "f"(in));
+  return subnormal ? ln_mul(r, 4096.f) : r;
+}
+SGL_DEVICE float ln_round_bf16(float x) {
+  return __bfloat162float(__float2bfloat16_rn(x));
+}
+
+struct LnWelford {
+  float mean, m2, count;
+};
+
+SGL_DEVICE void ln_push(LnWelford& w, float val) {
+  const float delta = ln_sub(val, w.mean);
+  const float count = ln_add(w.count, 1.f);
+  const float mean = ln_fma(delta, ln_rcp(count), w.mean);
+  w.m2 = ln_fma(delta, ln_sub(val, mean), w.m2);
+  w.mean = mean;
+  w.count = count;
+}
+
+// cuWelfordCombine with b = self (lower lane / warp), a = other; the op order matters.
+SGL_DEVICE LnWelford ln_combine(const LnWelford& b, const LnWelford& a) {
+  const float count = ln_add(a.count, b.count);
+  if (!(count > 0.f)) return LnWelford{0.f, 0.f, count};
+  const float coef = ln_rcp(count);
+  const float delta = ln_sub(b.mean, a.mean);
+  const float n_b = ln_mul(coef, b.count);
+  const float n_a = ln_mul(a.count, coef);
+  const float mean = ln_fma(a.mean, n_a, ln_mul(n_b, b.mean));
+  const float m2 = ln_fma(n_b, ln_mul(a.count, ln_mul(delta, delta)), ln_add(a.m2, b.m2));
+  return LnWelford{mean, m2, count};
